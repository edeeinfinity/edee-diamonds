{%- comment -%}
  Edee Infinity: live loose-diamond search. Reads the diamond list published to GitHub Pages every 30 minutes
  and adds stones to the cart through the Edee cart worker (Cloudflare). Hidden until "Diamond list URL" is set.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign api = s.data_url | strip
  assign cart_api = s.cart_url | strip
-%}
{%- if api != blank -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&display=swap">
<style>
  .eds { --ink:#0F1419; --gold:#B8935A; --gold2:#C9A66B; --cream:#FAF6EE; --line:#E7E1D6; --muted:#5E6670; --ok:#2E7D5B;
         color:var(--ink); font-family: Jost, var(--font-body--family, sans-serif); padding: 40px 16px 24px; }
  .eds *, .eds *::before, .eds *::after { box-sizing:border-box; }
  .eds__wrap { max-width:1320px; margin:0 auto; }
  .eds__kicker { font-size:11px; letter-spacing:.3em; text-transform:uppercase; color:var(--gold); margin:0 0 8px; }
  .eds__h1 { font-family:'Cormorant Garamond', Georgia, serif; font-variant-numeric: lining-nums; font-weight:600; font-size:clamp(34px,5vw,52px); line-height:1.05; margin:0 0 10px; }
  .eds__intro { color:var(--muted); max-width:720px; line-height:1.6; margin:0 0 24px; }
  .eds__panel { border:1px solid var(--line); border-radius:16px; background:var(--cream); padding:18px; }
  .eds__label { display:block; font-size:11px; letter-spacing:.18em; text-transform:uppercase; color:var(--muted); margin:0 0 10px; }
  .eds__shapes { display:flex; gap:8px; overflow-x:auto; padding-bottom:4px; scrollbar-width:thin; }
  .eds .eds__shape { flex:0 0 auto; display:flex; flex-direction:column; align-items:center; gap:6px; width:78px; padding:10px 4px 8px; border:1px solid var(--line);
                     border-radius:12px; background:#fff; cursor:pointer; font:inherit; font-size:11.5px; color:var(--ink); transition: border-color .2s, box-shadow .2s; }
  .eds .eds__shape svg { width:30px; height:30px; stroke:currentColor; fill:none; stroke-width:1.2; }
  .eds .eds__shape[aria-pressed="true"] { border-color:var(--gold); box-shadow: inset 0 0 0 1px var(--gold); background:#fffdf8; }
  .eds__grid-f { display:grid; grid-template-columns:1fr; gap:18px; margin-top:18px; }
  .eds__range { display:flex; align-items:center; gap:8px; }
  .eds__range input { width:100%; min-width:0; padding:10px 12px; border:1px solid var(--line); border-radius:10px; font:inherit; background:#fff; color:var(--ink); }
  .eds__presets { display:flex; flex-wrap:wrap; gap:6px; margin-top:8px; }
  .eds__chips { display:flex; flex-wrap:wrap; gap:6px; }
  .eds .eds__chip { padding:8px 12px; border:1px solid var(--line); border-radius:999px; background:#fff; font:inherit; font-size:13px; color:var(--ink); cursor:pointer; line-height:1; }
  .eds .eds__chip[aria-pressed="true"] { border-color:var(--ink); background:var(--ink); color:#fff; }
  .eds .eds__chip--sm { font-size:12px; padding:6px 10px; }
  .eds__more { display:none; }
  .eds__more.is-open { display:grid; }
  .eds .eds__toggle { margin-top:14px; background:none; border:0; padding:0; font:inherit; font-size:12px; letter-spacing:.16em; text-transform:uppercase; color:var(--ink); border-bottom:1px solid var(--gold); cursor:pointer; }
  .eds__bar { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:12px; margin:22px 0 14px; }
  .eds__count { font-size:14px; color:var(--muted); }
  .eds__count b { color:var(--ink); font-weight:500; }
  .eds__live { display:inline-flex; align-items:center; gap:6px; margin-left:10px; font-size:12px; color:var(--ok); }
  .eds__live::before { content:""; width:7px; height:7px; border-radius:50%; background:var(--ok); box-shadow:0 0 0 3px rgba(46,125,91,.18); }
  .eds__sort { padding:9px 12px; border:1px solid var(--line); border-radius:10px; font:inherit; background:#fff; color:var(--ink); }
  .eds__results { display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); gap:12px; }
  .eds .eds__card { display:flex; flex-direction:column; text-align:left; border:1px solid var(--line); border-radius:14px; background:#fff; overflow:hidden; cursor:pointer; font:inherit; color:var(--ink); padding:0; transition: box-shadow .2s, transform .2s; }
  .eds .eds__card:hover { box-shadow:0 10px 28px rgba(15,20,25,.10); transform: translateY(-2px); }
  .eds__img { aspect-ratio:1; background:#f4f4f4; display:flex; align-items:center; justify-content:center; overflow:hidden; }
  .eds__img img { width:100%; height:100%; object-fit:cover; }
  .eds__body { padding:12px 12px 14px; display:flex; flex-direction:column; gap:4px; }
  .eds__t { font-family:'Cormorant Garamond', Georgia, serif; font-variant-numeric: lining-nums; font-size:19px; font-weight:600; line-height:1.15; }
  .eds__spec { font-size:12.5px; color:var(--muted); }
  .eds__price { font-size:16px; font-weight:500; margin-top:4px; }
  .eds__empty, .eds__err { grid-column:1/-1; padding:40px 16px; text-align:center; color:var(--muted); border:1px dashed var(--line); border-radius:14px; }
  .eds__sk { border-radius:14px; background: linear-gradient(90deg,#f3f0ea 25%,#faf8f3 50%,#f3f0ea 75%); background-size:200% 100%; animation: edsSk 1.2s infinite; aspect-ratio: .78; }
  @keyframes edsSk { to { background-position:-200% 0; } }
  .eds__morebtn { display:flex; justify-content:center; margin:22px 0 6px; }
  .eds .eds__btn { display:inline-flex; align-items:center; justify-content:center; gap:10px; padding:14px 26px; border:1px solid var(--ink); background:var(--ink); color:#fff; border-radius:0;
                   font:inherit; font-size:12px; letter-spacing:.2em; text-transform:uppercase; cursor:pointer; }
  .eds .eds__btn--ghost { background:#fff; color:var(--ink); }
  .eds .eds__btn[disabled] { opacity:.6; cursor:wait; }
  .eds__note { font-size:12.5px; color:var(--muted); line-height:1.55; margin-top:16px; }
  /* dialog */
  .eds__dlg { width:min(980px, calc(100vw - 24px)); max-height:calc(100vh - 24px); padding:0; border:0; border-radius:18px; color:var(--ink); }
  .eds__dlg::backdrop { background:rgba(15,20,25,.55); }
  .eds__dlg-in { display:grid; grid-template-columns:1fr; }
  .eds__media { background:#f4f4f4; aspect-ratio:1; position:relative; }
  .eds__media iframe, .eds__media img { position:absolute; inset:0; width:100%; height:100%; border:0; object-fit:cover; }
  .eds__info { padding:22px 20px 24px; }
  .eds .eds__x { position:absolute; right:12px; top:12px; z-index:2; width:38px; height:38px; border-radius:50%; border:0; background:#fff; color:var(--ink); font-size:20px; cursor:pointer; box-shadow:0 2px 10px rgba(0,0,0,.15); }
  .eds__dl { display:grid; grid-template-columns: 1fr 1fr; gap:0; margin:16px 0; border-top:1px solid var(--line); }
  .eds__dl div { padding:9px 0; border-bottom:1px solid var(--line); font-size:13.5px; }
  .eds__dl dt { font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:var(--muted); }
  .eds__dl dd { margin:2px 0 0; }
  .eds__bigprice { font-size:26px; font-weight:500; margin:6px 0 2px; }
  .eds__gst { font-size:12px; color:var(--muted); }
  .eds__acts { display:flex; flex-wrap:wrap; gap:10px; margin-top:16px; }
  .eds__msg { margin-top:10px; font-size:13px; color:#A33; min-height:1em; }
  .eds a.eds__link { color:var(--ink); border-bottom:1px solid var(--gold); text-decoration:none; }
  @media (min-width: 750px) {
    .eds { padding: 56px 32px 32px; }
    .eds__grid-f, .eds__more.is-open { grid-template-columns: repeat(2, 1fr); }
    .eds__results { grid-template-columns:repeat(3, minmax(0,1fr)); gap:16px; }
    .eds__dlg-in { grid-template-columns: 1.05fr 1fr; }
    .eds__media { aspect-ratio:auto; min-height:520px; }
    .eds__info { padding:34px 32px; }
  }
  @media (min-width: 1100px) {
    .eds__grid-f, .eds__more.is-open { grid-template-columns: repeat(4, 1fr); }
    .eds__results { grid-template-columns:repeat(4, minmax(0,1fr)); }
  }
</style>

<section class="eds" id="eds-{{ section.id }}" data-api="{{ api | escape }}" data-cart="{{ cart_api | escape }}" data-per="{{ s.per_page | default: 24 }}" data-consult="{{ s.consult_url | default: '/pages/contact' }}">
  <div class="eds__wrap">
    {%- if s.kicker != blank -%}<p class="eds__kicker">{{ s.kicker }}</p>{%- endif -%}
    <h1 class="eds__h1">{{ s.heading | default: page.title }}</h1>
    {%- if s.intro != blank -%}<p class="eds__intro">{{ s.intro }}</p>{%- endif -%}

    <div class="eds__panel" role="search" aria-label="Filter diamonds">
      <span class="eds__label">Shape</span>
      <div class="eds__shapes" data-shapes></div>

      <div class="eds__grid-f">
        <div>
          <span class="eds__label">Carat</span>
          <div class="eds__range"><input type="number" inputmode="decimal" step="0.05" min="0" placeholder="Min" aria-label="Minimum carat" data-f="cmin"><span>–</span><input type="number" inputmode="decimal" step="0.05" min="0" placeholder="Max" aria-label="Maximum carat" data-f="cmax"></div>
          <div class="eds__presets">
            <button type="button" class="eds__chip eds__chip--sm" data-preset="0.5,0.99">0.5–1</button>
            <button type="button" class="eds__chip eds__chip--sm" data-preset="1,1.49">1–1.5</button>
            <button type="button" class="eds__chip eds__chip--sm" data-preset="1.5,1.99">1.5–2</button>
            <button type="button" class="eds__chip eds__chip--sm" data-preset="2,2.99">2–3</button>
            <button type="button" class="eds__chip eds__chip--sm" data-preset="3,">3+</button>
          </div>
        </div>
        <div>
          <span class="eds__label">Price (A$)</span>
          <div class="eds__range"><input type="number" inputmode="numeric" step="50" min="0" placeholder="Min" aria-label="Minimum price" data-f="pmin"><span>–</span><input type="number" inputmode="numeric" step="50" min="0" placeholder="Max" aria-label="Maximum price" data-f="pmax"></div>
        </div>
        <div>
          <span class="eds__label">Colour</span>
          <div class="eds__chips" data-multi="colour">
            {%- assign opts = 'D,E,F,G,H' | split: ',' -%}{%- for c in opts -%}<button type="button" class="eds__chip" aria-pressed="false" data-v="{{ c }}">{{ c }}</button>{%- endfor -%}
          </div>
        </div>
        <div>
          <span class="eds__label">Clarity</span>
          <div class="eds__chips" data-multi="clarity">
            {%- assign opts = 'FL,IF,VVS1,VVS2,VS1,VS2,SI1,SI2' | split: ',' -%}{%- for c in opts -%}<button type="button" class="eds__chip eds__chip--sm" aria-pressed="false" data-v="{{ c }}">{{ c }}</button>{%- endfor -%}
          </div>
        </div>
      </div>

      <div class="eds__grid-f eds__more" data-more>
        <div>
          <span class="eds__label">Cut</span>
          <div class="eds__chips" data-multi="cut">
            {%- assign opts = 'Ideal,Excellent,Very Good' | split: ',' -%}{%- for c in opts -%}<button type="button" class="eds__chip eds__chip--sm" aria-pressed="false" data-v="{{ c }}">{{ c }}</button>{%- endfor -%}
          </div>
        </div>
        <div>
          <span class="eds__label">Certificate</span>
          <div class="eds__chips" data-multi="lab">
            <button type="button" class="eds__chip eds__chip--sm" aria-pressed="false" data-v="IGI">IGI</button>
            <button type="button" class="eds__chip eds__chip--sm" aria-pressed="false" data-v="GIA">GIA</button>
          </div>
        </div>
        <div>
          <span class="eds__label">Growth method</span>
          <div class="eds__chips" data-multi="growth">
            <button type="button" class="eds__chip eds__chip--sm" aria-pressed="false" data-v="CVD">CVD</button>
            <button type="button" class="eds__chip eds__chip--sm" aria-pressed="false" data-v="HPHT">HPHT</button>
          </div>
        </div>
        <div style="display:flex;align-items:flex-end">
          <button type="button" class="eds__chip eds__chip--sm" data-reset>Clear all filters</button>
        </div>
      </div>
      <button type="button" class="eds__toggle" data-toggle aria-expanded="false">More filters</button>
    </div>

    <div class="eds__bar">
      <div class="eds__count" aria-live="polite" data-count>Loading diamonds…</div>
      <label><span class="visually-hidden" style="position:absolute;left:-9999px">Sort by</span>
        <select class="eds__sort" data-sort>
          <option value="price_asc">Price: low to high</option>
          <option value="price_desc">Price: high to low</option>
          <option value="carat_desc">Carat: high to low</option>
          <option value="carat_asc">Carat: low to high</option>
        </select>
      </label>
    </div>
    <div class="eds__results" data-results></div>
    <div class="eds__morebtn"><button type="button" class="eds__btn eds__btn--ghost" data-loadmore hidden>Show more diamonds</button></div>
    {%- if s.note != blank -%}<p class="eds__note">{{ s.note }}</p>{%- endif -%}
  </div>

  <dialog class="eds__dlg" data-dlg aria-label="Diamond details">
    <button type="button" class="eds__x" data-close aria-label="Close">&times;</button>
    <div class="eds__dlg-in">
      <div class="eds__media" data-media></div>
      <div class="eds__info" data-info></div>
    </div>
  </dialog>
</section>

<script>
(function () {
  var root = document.getElementById('eds-{{ section.id }}');
  if (!root) return;
  var API = root.dataset.api.replace(/\/+$/, ''), CART = (root.dataset.cart || '').replace(/\/+$/, ''), PER = +root.dataset.per || 24, CONSULT = root.dataset.consult;
  var $ = function (sel, el) { return (el || root).querySelector(sel); };
  var $$ = function (sel, el) { return Array.prototype.slice.call((el || root).querySelectorAll(sel)); };
  var money = new Intl.NumberFormat('en-AU', { style: 'currency', currency: 'AUD', maximumFractionDigits: 0 });
  var esc = function (v) { return String(v == null ? '' : v).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); };
  var ICON = {
    Round: '<circle cx="15" cy="15" r="12"/><circle cx="15" cy="15" r="6"/>',
    Oval: '<ellipse cx="15" cy="15" rx="9" ry="13"/><ellipse cx="15" cy="15" rx="4.5" ry="7"/>',
    Pear: '<path d="M15 2C10 9 6 13 6 19a9 9 0 0 0 18 0c0-6-4-10-9-17z"/>',
    Emerald: '<path d="M10 2h10l5 5v16l-5 5H10l-5-5V7z"/><path d="M12 7h6l2 2v12l-2 2h-6l-2-2V9z"/>',
    Cushion: '<rect x="4" y="4" width="22" height="22" rx="7"/><rect x="10" y="10" width="10" height="10" rx="3"/>',
    'Elongated Cushion': '<rect x="7" y="2" width="16" height="26" rx="6"/>',
    Princess: '<rect x="4" y="4" width="22" height="22"/><path d="M4 4l22 22M26 4L4 26"/>',
    Marquise: '<path d="M15 1c6 6 8 10 8 14s-2 8-8 14C9 23 7 19 7 15s2-8 8-14z"/>',
    Radiant: '<path d="M9 3h12l4 4v16l-4 4H9l-4-4V7z"/><path d="M5 7l20 16M25 7L5 23"/>',
    Heart: '<path d="M15 26S3 18 3 10a6 6 0 0 1 12-2 6 6 0 0 1 12 2c0 8-12 16-12 16z"/>',
    Asscher: '<path d="M10 3h10l7 7v10l-7 7H10l-7-7V10z"/><path d="M12 8h6l4 4v6l-4 4h-6l-4-4v-6z"/>',
    Trilliant: '<path d="M15 3l12 22H3z"/>',
    Baguette: '<rect x="9" y="3" width="12" height="24"/>',
    'Old Mine': '<rect x="4" y="4" width="22" height="22" rx="9"/><path d="M15 4v22M4 15h22"/>',
    'Half Moon': '<path d="M3 20a12 12 0 0 1 24 0z"/>',
    Lozenge: '<path d="M15 2l9 13-9 13-9-13z"/>',
    Trapezoid: '<path d="M8 6h14l5 18H3z"/>',
    Hexagonal: '<path d="M9 3h12l6 12-6 12H9L3 15z"/>',
    Moval: '<path d="M15 2c6 4 9 8 9 13s-3 9-9 13c-6-4-9-8-9-13s3-9 9-13z"/>',
    Kite: '<path d="M15 2l9 9-9 17-9-17z"/>',
    Shield: '<path d="M5 4h20l-2 14-8 9-8-9z"/>',
    Rose: '<circle cx="15" cy="15" r="12"/><path d="M15 3l4 12-4 12-4-12z"/>',
    'Other Fancy': '<path d="M15 3l3.5 8 8.5.7-6.5 5.6 2 8.4L15 21l-7.5 4.7 2-8.4L3 11.7l8.5-.7z"/>'
  };
  var MAIN = ['Round', 'Oval', 'Pear', 'Emerald', 'Cushion', 'Elongated Cushion', 'Princess', 'Marquise', 'Radiant', 'Heart', 'Asscher'];

  var state = { shape: [], colour: [], clarity: [], cut: [], lab: [], growth: [], cmin: '', cmax: '', pmin: '', pmax: '', sort: 'price_asc', page: 1 };
  var ALL = null, META = null, matches = [], items = [], total = 0, updatedAt = null, timer = null, details = {};

  var qs = new URLSearchParams(location.search);
  ['shape', 'colour', 'clarity', 'cut', 'lab', 'growth'].forEach(function (k) { if (qs.get(k)) state[k] = qs.get(k).split(','); });
  ['cmin', 'cmax', 'pmin', 'pmax', 'sort'].forEach(function (k) { if (qs.get(k)) state[k] = qs.get(k); });

  function saveUrl() {
    var p = new URLSearchParams();
    ['shape', 'colour', 'clarity', 'cut', 'lab', 'growth'].forEach(function (k) { if (state[k].length) p.set(k, state[k].join(',')); });
    ['cmin', 'cmax', 'pmin', 'pmax'].forEach(function (k) { if (state[k] !== '') p.set(k, state[k]); });
    if (state.sort !== 'price_asc') p.set('sort', state.sort);
    var url = p.toString();
    history.replaceState(null, '', location.pathname + (url ? '?' + url : ''));
  }

  function ago(iso) {
    if (!iso) return '';
    var m = Math.round((Date.now() - new Date(iso)) / 60000);
    return m < 1 ? 'just now' : m < 60 ? m + ' min ago' : Math.round(m / 60) + ' h ago';
  }
  function spec(d) { return [d.colour, d.clarity, d.cut, d.lab].filter(Boolean).join(' · '); }
  function titleOf(d) { return d.carat.toFixed(2) + ' ct ' + d.shape; }
  function bucketOf(id, n) { var h = 0; for (var i = 0; i < id.length; i++) h = (Math.imul(h, 31) + id.charCodeAt(i)) >>> 0; return h % n; }

  function card(d) {
    return '<button type="button" class="eds__card" data-id="' + esc(d.id) + '">' +
      '<span class="eds__img"><img loading="lazy" src="' + esc(d.image) + '" alt="' + esc(titleOf(d) + ' lab-grown diamond') + '" onerror="this.style.opacity=0"></span>' +
      '<span class="eds__body"><span class="eds__t">' + esc(titleOf(d)) + '</span><span class="eds__spec">' + esc(spec(d)) + '</span>' +
      '<span class="eds__price">' + money.format(d.price) + '</span></span></button>';
  }

  function render(append) {
    var box = $('[data-results]');
    if (!append) box.innerHTML = '';
    if (!items.length) { box.innerHTML = '<div class="eds__empty">No diamonds match these filters right now. Try widening the carat or price range, or <a class="eds__link" href="#request">send us a request</a>.</div>'; }
    else box.insertAdjacentHTML('beforeend', items.slice(append ? -append : 0).map(card).join(''));
    $('[data-count]').innerHTML = '<b>' + total.toLocaleString('en-AU') + '</b> diamond' + (total === 1 ? '' : 's') + (updatedAt ? '<span class="eds__live">Live · updated ' + ago(updatedAt) + '</span>' : '');
    $('[data-loadmore]').hidden = items.length >= total;
  }

  function decode(m, rows) {
    return rows.map(function (r) {
      return { id: r[0], shape: m.shapes[r[1]], carat: r[2], colour: m.colours[r[3]], clarity: m.clarities[r[4]], cut: m.cuts[r[5]] || '',
               lab: m.labs[r[6]], growth: m.growths[r[7]] || '', price: r[8], image: r[9] >= 0 ? m.prefixes[r[9]] + r[10] : '' };
    });
  }

  function apply() {
    var f = state, n = function (v) { return v === '' || v == null || isNaN(+v) ? null : +v; };
    var cmin = n(f.cmin), cmax = n(f.cmax), pmin = n(f.pmin), pmax = n(f.pmax);
    var cuts = f.cut.map(function (c) { return c.toLowerCase(); });
    matches = ALL.filter(function (s) {
      return (!f.shape.length || f.shape.indexOf(s.shape) > -1) && (!f.colour.length || f.colour.indexOf(s.colour) > -1) &&
        (!f.clarity.length || f.clarity.indexOf(s.clarity) > -1) && (!cuts.length || cuts.indexOf(s.cut.toLowerCase()) > -1) &&
        (!f.lab.length || f.lab.indexOf(s.lab) > -1) && (!f.growth.length || f.growth.indexOf(s.growth) > -1) &&
        (cmin === null || s.carat >= cmin) && (cmax === null || s.carat <= cmax) && (pmin === null || s.price >= pmin) && (pmax === null || s.price <= pmax);
    });
    var key = f.sort.split('_')[0] === 'carat' ? 'carat' : 'price', sign = /desc$/.test(f.sort) ? -1 : 1;
    matches.sort(function (a, b) { return sign * (a[key] - b[key]) || a.price - b.price; });
    total = matches.length;
  }

  function load(page) {
    if (!ALL) return;
    saveUrl();
    if (page === 1) { apply(); items = matches.slice(0, PER); state.page = 1; render(0); }
    else { var more = matches.slice(items.length, items.length + PER); items = items.concat(more); state.page = page; render(more.length); }
  }
  function reload() { clearTimeout(timer); timer = setTimeout(function () { load(1); }, 200); }

  function boot() {
    $('[data-results]').innerHTML = new Array(8).fill('<div class="eds__sk"></div>').join('');
    var bust = '?t=' + Math.floor(Date.now() / 300000);
    Promise.all([fetch(API + '/meta.json' + bust).then(function (r) { return r.json(); }), fetch(API + '/stones.json' + bust).then(function (r) { return r.json(); })])
      .then(function (res) {
        META = res[0]; updatedAt = res[1].updatedAt || META.updatedAt; ALL = decode(META, res[1].rows);
        var counts = {}; ALL.forEach(function (s) { counts[s.shape] = (counts[s.shape] || 0) + 1; });
        var names = Object.keys(counts);
        var ordered = MAIN.filter(function (n) { return counts[n]; }).concat(names.filter(function (n) { return MAIN.indexOf(n) < 0 && n !== 'Other Fancy' && counts[n] >= 20; }).sort(function (a, b) { return counts[b] - counts[a]; })).concat(counts['Other Fancy'] ? ['Other Fancy'] : []);
        $('[data-shapes]').innerHTML = ordered.map(function (n) {
          return '<button type="button" class="eds__shape" aria-pressed="false" data-v="' + esc(n) + '"><svg viewBox="0 0 30 30" aria-hidden="true">' + (ICON[n] || '<path d="M8 4h14l5 7-12 16L3 11z"/>') + '</svg>' + esc(n) + '</button>';
        }).join('');
        sync(); load(1);
      })
      .catch(function () {
        $('[data-results]').innerHTML = '<div class="eds__err">Our live diamond list is updating. Please try again in a minute, or <a class="eds__link" href="#request">send us a request</a>.</div>';
        $('[data-count]').textContent = '';
      });
  }

  function sync() {
    $$('[data-shapes] [data-v]').forEach(function (b) { b.setAttribute('aria-pressed', state.shape.indexOf(b.dataset.v) > -1); });
    $$('[data-multi]').forEach(function (g) {
      var k = g.dataset.multi;
      $$('[data-v]', g).forEach(function (b) { b.setAttribute('aria-pressed', state[k].indexOf(b.dataset.v) > -1); });
    });
    $$('[data-f]').forEach(function (i) { i.value = state[i.dataset.f]; });
    $('[data-sort]').value = state.sort;
  }

  function toggle(k, v) { var a = state[k], i = a.indexOf(v); if (i > -1) a.splice(i, 1); else a.push(v); sync(); reload(); }

  root.addEventListener('click', function (e) {
    var t = e.target.closest('button'); if (!t || !root.contains(t)) return;
    if (t.closest('[data-shapes]')) return toggle('shape', t.dataset.v);
    var g = t.closest('[data-multi]'); if (g) return toggle(g.dataset.multi, t.dataset.v);
    if (t.dataset.preset !== undefined) { var p = t.dataset.preset.split(','); state.cmin = p[0]; state.cmax = p[1] || ''; sync(); return reload(); }
    if (t.hasAttribute('data-reset')) { ['shape', 'colour', 'clarity', 'cut', 'lab', 'growth'].forEach(function (k) { state[k] = []; }); state.cmin = state.cmax = state.pmin = state.pmax = ''; sync(); return reload(); }
    if (t.hasAttribute('data-toggle')) { var m = $('[data-more]'); var isOpen = !m.classList.contains('is-open'); m.classList.toggle('is-open', isOpen); t.setAttribute('aria-expanded', isOpen); t.textContent = isOpen ? 'Fewer filters' : 'More filters'; return; }
    if (t.hasAttribute('data-loadmore')) return load(state.page + 1);
    if (t.classList.contains('eds__card')) return openStone(t.dataset.id);
    if (t.hasAttribute('data-close')) return $('[data-dlg]').close();
    if (t.hasAttribute('data-add')) return add(t);
  });
  $$('[data-f]').forEach(function (i) { i.addEventListener('input', function () { state[i.dataset.f] = i.value; reload(); }); });
  $('[data-sort]').addEventListener('change', function (e) { state.sort = e.target.value; load(1); });
  $('[data-dlg]').addEventListener('click', function (e) { if (e.target === e.currentTarget) e.currentTarget.close(); });

  function row(k, v) { return v ? '<div><dt>' + k + '</dt><dd>' + esc(v) + '</dd></div>' : ''; }

  function openStone(id) {
    var base = items.find(function (x) { return x.id === id; }); if (!base) return;
    var b = bucketOf(id, (META && META.buckets) || 64);
    var got = details[b] ? Promise.resolve(details[b]) : fetch(API + '/d/' + b + '.json?t=' + Math.floor(Date.now() / 300000)).then(function (r) { return r.json(); }).then(function (j) { return (details[b] = j); });
    got.then(function (j) { show(j[id] || base); }).catch(function () { show(base); });
  }
  function show(d) {
    var media = $('[data-media]');
    media.innerHTML = d.video
      ? '<iframe src="' + esc(d.video) + '" title="360° view of the diamond" loading="lazy" allow="fullscreen" sandbox="allow-scripts allow-same-origin"></iframe>'
      : '<img src="' + esc(d.image) + '" alt="">';
    $('[data-info]').innerHTML =
      '<p class="eds__kicker">Certified lab-grown diamond</p>' +
      '<h2 class="eds__h1" style="font-size:34px">' + esc(titleOf(d)) + '</h2>' +
      '<div class="eds__bigprice">' + money.format(d.price) + '</div><div class="eds__gst">AUD, includes GST and insured delivery</div>' +
      '<dl class="eds__dl">' + row('Colour', d.colour) + row('Clarity', d.clarity) + row('Cut', d.cut) + row('Polish', d.polish) + row('Symmetry', d.symmetry) +
        row('Fluorescence', d.fluorescence) + row('Measurements (mm)', d.measurements) + row('Depth / Table', d.depth && d.table ? d.depth + '% / ' + d.table + '%' : '') +
        row('Growth', d.growth) + row('Certificate', d.cert ? d.lab + ' ' + d.cert : '') + '</dl>' +
      (d.certUrl ? '<p style="margin:0;font-size:13.5px"><a class="eds__link" href="' + esc(d.certUrl) + '" target="_blank" rel="noopener">View the ' + esc(d.lab) + ' report</a></p>' : '') +
      '<div class="eds__acts"><button type="button" class="eds__btn" data-add="' + esc(d.id) + '">Add to cart</button>' +
      '<a class="eds__btn eds__btn--ghost" href="' + esc(CONSULT) + '?diamond=' + encodeURIComponent(d.lab + ' ' + (d.cert || d.id)) + '">Set it in a ring</a></div>' +
      '<div class="eds__msg" role="alert" data-msg></div>' +
      '<p class="eds__note">Live inventory from our cutting partner, refreshed every 30 minutes. We confirm the stone within 24 hours of your order; if it has just sold, we will offer a matching alternative or a full refund.</p>';
    $('[data-dlg]').showModal();
  }

  function add(btn) {
    var msg = $('[data-msg]'); msg.textContent = ''; btn.disabled = true; btn.textContent = 'Adding…';
    if (!CART) { msg.textContent = 'Online checkout for loose diamonds is coming soon. Please use "Set it in a ring" to enquire.'; btn.disabled = false; btn.textContent = 'Add to cart'; return; }
    fetch(CART + '/cart-line', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id: btn.dataset.add }) })
      .then(function (r) { return r.json().then(function (j) { if (!r.ok) throw new Error(j.error || 'Error'); return j; }); })
      .then(function (j) {
        var d = (details[bucketOf(btn.dataset.add, (META && META.buckets) || 64)] || {})[btn.dataset.add] || {};
        return fetch((window.Shopify && Shopify.routes ? Shopify.routes.root : '/') + 'cart/add.js', {
          method: 'POST', headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify({ items: [{ id: j.variantId, quantity: 1, properties: { Certificate: (d.lab || '') + ' ' + (d.cert || '') } }] })
        }).then(function (r) { if (!r.ok) throw new Error('Could not add to cart. Please try again.'); });
      })
      .then(function () { location.href = (window.Shopify && Shopify.routes ? Shopify.routes.root : '/') + 'cart'; })
      .catch(function (e) { msg.textContent = e.message; btn.disabled = false; btn.textContent = 'Add to cart'; });
  }

  sync();
  boot();
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Edee diamond search",
  "tag": "div",
  "class": "edee-diamond-search-section",
  "settings": [
    { "type": "text", "id": "data_url", "label": "Diamond list URL", "info": "GitHub Pages address, e.g. https://edeeinfinity.github.io/edee-diamonds. The section stays hidden while this is empty." },
    { "type": "text", "id": "cart_url", "label": "Cart worker URL", "info": "Cloudflare worker address, e.g. https://edee-cart.<name>.workers.dev" },
    { "type": "text", "id": "kicker", "label": "Small heading", "default": "Live inventory" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loose lab-grown diamonds" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Search thousands of IGI and GIA certified lab-grown diamonds, updated every 30 minutes. Buy a stone loose, or have it set in a ring, pendant or earrings made for you." },
    { "type": "range", "id": "per_page", "label": "Diamonds per load", "min": 12, "max": 48, "step": 4, "default": 24 },
    { "type": "text", "id": "consult_url", "label": "'Set it in a ring' link", "default": "/pages/contact" },
    { "type": "textarea", "id": "note", "label": "Note under results", "default": "Prices are in Australian dollars and include GST and insured delivery. Every diamond comes with its original IGI or GIA report." }
  ],
  "presets": [ { "name": "Edee diamond search" } ]
}
{% endschema %}

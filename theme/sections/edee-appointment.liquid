{%- comment -%}
  Edee Infinity: book an appointment (virtual video call or Parramatta by appointment).
  Sends through the store contact form to info@edeeinfinity.com; we confirm the time by email or phone.
{%- endcomment -%}
<section class="edap" id="edap-{{ section.id }}">
  <div class="edap__in">
    <div class="edap__intro">
      <p class="edap__eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="edap__h">{{ section.settings.heading }}</h1>
      <div class="edap__text">{{ section.settings.intro }}</div>
      <div class="edap__opts">
        <div class="edap__opt">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="5.5" width="13" height="13" rx="2"/><path d="M15.5 10l6-3.5v11l-6-3.5"/></svg>
          <div><strong>Virtual consultation</strong><span>A video call on Google Meet, WhatsApp or FaceTime. We show you designs, metals and stones live, from anywhere in Australia.</span></div>
        </div>
        <div class="edap__opt">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
          <div><strong>Parramatta, by appointment</strong><span>{{ section.settings.address }}<br>{{ section.settings.hours }}</span></div>
        </div>
      </div>
      <p class="edap__small">{{ section.settings.note }}</p>
    </div>

    <div class="edap__card">
      {%- form 'contact', id: 'edee-appointment-form', class: 'edap__form' -%}
        {%- if form.posted_successfully? -%}
          <div class="edap__ok" role="status">
            <h2>Thank you, your request is in.</h2>
            <p>We'll confirm your appointment by email or phone within one business day. If you need us sooner, message us on WhatsApp at <a href="https://wa.me/61451849993">+61 451 849 993</a>.</p>
          </div>
        {%- else -%}
          <h2 class="edap__formh">Request a time</h2>
          {%- if form.errors -%}<div class="edap__err">{{ form.errors | default_errors }}</div>{%- endif -%}
          <input type="hidden" name="contact[Enquiry]" value="Appointment request">
          <fieldset class="edap__type">
            <legend>Appointment type</legend>
            <label><input type="radio" name="contact[Appointment type]" value="Virtual consultation" checked> Virtual</label>
            <label><input type="radio" name="contact[Appointment type]" value="Parramatta in person"> In person, Parramatta</label>
          </fieldset>
          <div class="edap__grid">
            <label>Your name<input type="text" name="contact[name]" autocomplete="name" required></label>
            <label>Phone<input type="tel" name="contact[phone]" autocomplete="tel" required></label>
            <label class="edap__full">Email<input type="email" name="contact[email]" autocomplete="email" required></label>
            <label>Preferred date<input type="date" name="contact[Preferred date]" required data-edap-date></label>
            <label>Preferred time
              <select name="contact[Preferred time]" required>
                <option value="">Choose a time</option>
                {%- assign slots = '11:00 am,11:30 am,12:00 pm,12:30 pm,1:00 pm,1:30 pm,2:00 pm,2:30 pm,3:00 pm,3:30 pm,4:00 pm,4:30 pm' | split: ',' -%}
                {%- for s in slots -%}<option>{{ s }}</option>{%- endfor -%}
              </select>
            </label>
            <label>I'm looking for
              <select name="contact[Looking for]">
                <option>Engagement ring</option><option>Wedding band</option><option>Earrings, pendant or bracelet</option>
                <option>Loose diamond</option><option>Custom design</option><option>Corporate or trade enquiry</option><option>Something else</option>
              </select>
            </label>
            <label>Budget (optional)
              <select name="contact[Budget]">
                <option value="">Prefer not to say</option><option>Under $1,000</option><option>$1,000 to $2,500</option>
                <option>$2,500 to $5,000</option><option>$5,000 to $10,000</option><option>Over $10,000</option>
              </select>
            </label>
            <label class="edap__full">Anything we should know? (optional)<textarea name="contact[body]" rows="3" placeholder="Designs you like, ring size, deadline…"></textarea></label>
          </div>
          <button type="submit" class="edap__btn">Request appointment</button>
          <p class="edap__fine">Times are in Sydney time, Monday to Friday. Your appointment is confirmed once we reply.</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

<style>
  #edap-{{ section.id }} { background: #F5FBFF; color: #0F1419; font-family: Jost, var(--font-body--family, sans-serif); }
  #edap-{{ section.id }} .edap__in { max-width: 1180px; margin: 0 auto; padding: 56px 20px 72px; display: grid; gap: 40px; grid-template-columns: 1fr; }
  #edap-{{ section.id }} .edap__eyebrow { margin: 0 0 10px; font-size: 12px; letter-spacing: .28em; text-transform: uppercase; color: #9C7A43; }
  #edap-{{ section.id }} .edap__h { margin: 0 0 16px; font-weight: 400; font-size: clamp(30px, 4vw, 44px); line-height: 1.15; }
  #edap-{{ section.id }} .edap__text { font-size: 16px; line-height: 1.65; color: #3a434b; }
  #edap-{{ section.id }} .edap__opts { display: grid; gap: 16px; margin: 26px 0 18px; }
  #edap-{{ section.id }} .edap__opt { display: flex; gap: 14px; align-items: flex-start; background: #fff; border: 1px solid rgba(15,20,25,.08); border-radius: 14px; padding: 16px 18px; }
  #edap-{{ section.id }} .edap__opt svg { flex: 0 0 26px; width: 26px; height: 26px; fill: none; stroke: #0F1419; stroke-width: 1.4; stroke-linejoin: round; }
  #edap-{{ section.id }} .edap__opt strong { display: block; font-weight: 500; margin-bottom: 3px; }
  #edap-{{ section.id }} .edap__opt span { font-size: 14.5px; line-height: 1.55; color: #4a525a; }
  #edap-{{ section.id }} .edap__small { font-size: 14px; color: #4a525a; line-height: 1.6; }
  #edap-{{ section.id }} .edap__card { background: #fff; border-radius: 18px; border: 1px solid rgba(15,20,25,.08); box-shadow: 0 18px 40px rgba(15,20,25,.06); padding: 26px 22px; }
  #edap-{{ section.id }} .edap__formh, #edap-{{ section.id }} .edap__ok h2 { margin: 0 0 16px; font-weight: 500; font-size: 22px; }
  #edap-{{ section.id }} .edap__ok p { line-height: 1.6; color: #3a434b; }
  #edap-{{ section.id }} .edap__type { border: 0; padding: 0; margin: 0 0 16px; display: flex; flex-wrap: wrap; gap: 10px; }
  #edap-{{ section.id }} .edap__type legend { font-size: 13px; color: #4a525a; margin-bottom: 8px; }
  #edap-{{ section.id }} .edap__type label { display: inline-flex; align-items: center; gap: 8px; border: 1px solid #d8d1c4; border-radius: 999px; padding: 9px 16px; cursor: pointer; font-size: 14.5px; }
  #edap-{{ section.id }} .edap__type label:has(input:checked) { border-color: #0F1419; background: #0F1419; color: #fff; }
  #edap-{{ section.id }} .edap__type input { accent-color: #C9A66B; }
  #edap-{{ section.id }} .edap__grid { display: grid; gap: 12px; grid-template-columns: 1fr; }
  #edap-{{ section.id }} .edap__grid label { display: flex; flex-direction: column; gap: 6px; font-size: 13px; color: #4a525a; }
  #edap-{{ section.id }} .edap__grid input, #edap-{{ section.id }} .edap__grid select, #edap-{{ section.id }} .edap__grid textarea { font: inherit; font-size: 15px; padding: 11px 12px; border: 1px solid #d8d1c4; border-radius: 10px; background: #fff; color: #0F1419; min-height: 44px; }
  #edap-{{ section.id }} .edap__btn { margin-top: 16px; width: 100%; padding: 15px 26px; border: 0; background: #0F1419; color: #fff; font: inherit; font-size: 12.5px; letter-spacing: .2em; text-transform: uppercase; cursor: pointer; border-radius: 2px; }
  #edap-{{ section.id }} .edap__btn:hover { background: #1f2a33; }
  #edap-{{ section.id }} .edap__fine { margin: 10px 0 0; font-size: 12.5px; color: #6b737a; }
  #edap-{{ section.id }} .edap__err { color: #a33; margin-bottom: 12px; }
  @media (min-width: 750px) { #edap-{{ section.id }} .edap__grid { grid-template-columns: 1fr 1fr; } #edap-{{ section.id }} .edap__full { grid-column: 1 / -1; } #edap-{{ section.id }} .edap__card { padding: 32px; } }
  @media (min-width: 990px) { #edap-{{ section.id }} .edap__in { grid-template-columns: 1fr 1.05fr; gap: 56px; padding-top: 72px; align-items: start; } }
</style>
<script>
  (function () {
    var d = document.querySelector('#edap-{{ section.id }} [data-edap-date]');
    if (!d) return;
    var t = new Date(); t.setDate(t.getDate() + 1);
    var pad = function (n) { return (n < 10 ? '0' : '') + n; };
    d.min = t.getFullYear() + '-' + pad(t.getMonth() + 1) + '-' + pad(t.getDate());
    d.addEventListener('change', function () {
      var v = new Date(d.value + 'T12:00:00'), day = v.getDay();
      d.setCustomValidity(day === 0 || day === 6 ? 'Please choose a weekday (Monday to Friday).' : '');
    });
    if (location.search.indexOf('contact_posted') > -1) document.getElementById('edap-{{ section.id }}').scrollIntoView({ block: 'start' });
  })();
</script>

{% schema %}
{
  "name": "Edee appointment booking",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Private consultations" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Book an appointment" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Choose your ring with one of our team, one to one. We'll walk you through designs, metals and certified lab-grown diamonds, answer your questions and help with sizing. There's no cost and no obligation to buy.</p>" },
    { "type": "text", "id": "address", "label": "Address", "default": "Suite 18, Level 3, 27 Hunter St, Parramatta NSW 2150" },
    { "type": "text", "id": "hours", "label": "Hours", "default": "Monday to Friday, 11 am to 5 pm" },
    { "type": "text", "id": "note", "label": "Note under options", "default": "Prefer to chat now? Message us on WhatsApp or call +61 451 849 993." }
  ],
  "presets": [{ "name": "Edee appointment booking" }]
}
{% endschema %}

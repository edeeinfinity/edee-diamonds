{%- comment -%}
  Edee Infinity: "Meet our designer" homepage section (photo + short bio + link to the Edee Exclusive collection).
{%- endcomment -%}
<section class="edds" id="edds-{{ section.id }}">
  <div class="edds__in">
    <div class="edds__photo">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 420px, 80vw', alt: section.settings.name }}
      {%- elsif section.settings.file != blank -%}
        <img src="{{ section.settings.file | file_url }}" alt="{{ section.settings.name | escape }}" width="800" height="1000" loading="lazy">
      {%- endif -%}
    </div>
    <div class="edds__text">
      <p class="edds__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="edds__h">{{ section.settings.heading }}</h2>
      <p class="edds__role">{{ section.settings.name }} · {{ section.settings.role }}</p>
      <div class="edds__bio">{{ section.settings.bio }}</div>
      {%- if section.settings.link != blank -%}
        <a class="edds__btn" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>
<style>
  #edds-{{ section.id }} { background: {{ section.settings.bg }}; color: #0F1419; font-family: Jost, var(--font-body--family, sans-serif); }
  #edds-{{ section.id }} .edds__in { max-width: 1100px; margin: 0 auto; padding: 64px 20px; display: grid; gap: 32px; align-items: center; grid-template-columns: 1fr; }
  #edds-{{ section.id }} .edds__photo { max-width: 380px; width: 100%; margin: 0 auto; position: relative; }
  #edds-{{ section.id }} .edds__photo::before { content: ""; position: absolute; inset: 14px -14px -14px 14px; border: 1px solid #C9A66B; border-radius: 18px; }
  #edds-{{ section.id }} .edds__photo img { position: relative; display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 18px; box-shadow: 0 20px 44px rgba(15,20,25,.16); }
  #edds-{{ section.id }} .edds__eyebrow { margin: 0 0 10px; font-size: 12px; letter-spacing: .28em; text-transform: uppercase; color: #9C7A43; }
  #edds-{{ section.id }} .edds__h { margin: 0 0 8px; font-weight: 400; font-size: clamp(28px, 3.4vw, 40px); line-height: 1.15; }
  #edds-{{ section.id }} .edds__role { margin: 0 0 18px; font-size: 14px; letter-spacing: .08em; color: #4a525a; }
  #edds-{{ section.id }} .edds__bio { font-size: 16px; line-height: 1.7; color: #3a434b; max-width: 560px; }
  #edds-{{ section.id }} .edds__bio p { margin: 0 0 12px; }
  #edds-{{ section.id }} .edds__btn { display: inline-block; margin-top: 10px; padding: 14px 26px; background: #0F1419; color: #fff; text-decoration: none; font-size: 12.5px; letter-spacing: .2em; text-transform: uppercase; }
  #edds-{{ section.id }} .edds__btn:hover { background: #1f2a33; }
  @media (min-width: 990px) {
    #edds-{{ section.id }} .edds__in { grid-template-columns: 420px 1fr; gap: 72px; padding: 88px 20px; }
    #edds-{{ section.id }} .edds__photo { max-width: 420px; }
  }
  @media (max-width: 749px) { #edds-{{ section.id }} .edds__text { text-align: center; } #edds-{{ section.id }} .edds__bio { margin: 0 auto; } }
</style>
{% schema %}
{
  "name": "Edee designer",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "file", "label": "Or photo file name (Files)", "default": "edee-designer-krishnaa.jpg" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Meet our designer" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The hand behind Edee Exclusive" },
    { "type": "text", "id": "name", "label": "Name", "default": "Krishnaa Patel" },
    { "type": "text", "id": "role", "label": "Role", "default": "Jewellery Designer" },
    { "type": "richtext", "id": "bio", "label": "Bio" },
    { "type": "text", "id": "link", "label": "Button link", "default": "/collections/edee-exclusive" },
    { "type": "text", "id": "link_label", "label": "Button label", "default": "Explore her designs" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#F5FBFF" }
  ],
  "presets": [{ "name": "Edee designer" }]
}
{% endschema %}

{%- comment -%}
  Edee Infinity: floating WhatsApp chat button (same number as the website contact phone).
  Rendered from layout/theme.liquid.
{%- endcomment -%}
{%- liquid
  assign wa_number = '61451849993'
  assign wa_text = 'Hi Edee Infinity, I have a question about ' | append: page_title
-%}
<a class="edee-wa" href="https://wa.me/{{ wa_number }}?text={{ wa_text | url_encode }}" target="_blank" rel="noopener" aria-label="Chat with Edee Infinity on WhatsApp">
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M12 2.2a9.8 9.8 0 0 0-8.4 14.9L2.3 21.8l4.8-1.3A9.8 9.8 0 1 0 12 2.2z" fill="none" stroke="#fff" stroke-width="1.7" stroke-linejoin="round"/>
    <path d="M8.7 7.4c.25-.55.5-.56.75-.57h.62c.2 0 .45.03.66.5l.86 2.02c.07.18.08.37-.03.55l-.5.72c-.12.17-.18.33-.04.57.5.86 1.18 1.62 2.03 2.2.25.17.45.15.63-.04l.78-.86c.18-.2.38-.22.6-.12l1.86.88c.26.12.4.27.4.5 0 .53-.24 1.3-.85 1.72-.62.42-1.55.62-2.66.25-1.3-.43-2.62-1.22-3.72-2.32-1.1-1.1-1.9-2.4-2.22-3.62-.3-1.1-.02-2 .29-2.38z" fill="#fff"/>
  </svg>
  <span class="edee-wa__label">Chat on WhatsApp</span>
</a>
<style>
  .edee-wa { position: fixed; right: 18px; bottom: 18px; z-index: 2147483000; display: inline-flex; align-items: center; gap: 8px;
             padding: 12px; border-radius: 999px; background: #25D366; color: #fff; text-decoration: none;
             font: 500 14px/1 Jost, var(--font-body--family, sans-serif); letter-spacing: .02em;
             box-shadow: 0 6px 20px rgba(0,0,0,.25); transition: transform .2s ease, box-shadow .2s ease; }
  .edee-wa:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(0,0,0,.3); color: #fff; }
  .edee-wa svg { width: 30px; height: 30px; flex: 0 0 auto; }
  .edee-wa__label { display: none; }
  @media (min-width: 990px) { .edee-wa { padding: 11px 18px 11px 13px; } .edee-wa__label { display: inline; } }
  @media print { .edee-wa { display: none; } }
</style>
